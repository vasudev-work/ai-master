# ---------------------------------------------------------------------------
# Reference template only — NOT used at build time by this Android app.
#
# The app does not read a .env file. API keys are entered by the user in the
# app's Settings screen and stored encrypted on-device (EncryptedSharedPreferences
# + Android Keystore). Nothing secret is ever bundled into the APK.
#
# Keep this file only as documentation of the keys the app understands, or as a
# starting point if you later add build-time tooling that reads environment
# variables. Never commit a real .env with real keys.
# ---------------------------------------------------------------------------

# AI provider (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_provider_key_here
LLM_MODEL=gpt-4o-mini

# Web search grounding (optional)
BRAVE_SEARCH_API_KEY=your_brave_search_key_here
